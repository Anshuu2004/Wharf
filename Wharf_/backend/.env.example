# Supabase
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/wharf"
JWT_SECRET="your_jwt_secret_here"
FRONTEND_URL="http://localhost:5173"

# GitHub OAuth
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/github/callback"
ENCRYPTION_SECRET="your_encryption_secret_here"

# GitHub App Credentials 
GITHUB_APP_ID="YOUR_APP_ID"
GITHUB_CLIENT_ID="YOUR_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_CLIENT_SECRET"

# The Private Key
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# System API Key Pool Seeding (Used for Global Key Rotation)
# npx ts-node prisma/seed.ts
SEED_GEMINI_KEY="your_master_gemini_key"
SEED_GEMINI_KEY_1="another_gemini_key"
SEED_ANTHROPIC_KEY="your_anthropic_key"
SEED_OPENAI_KEY="your_openai_key"
SEED_GROQ_KEY="your_groq_key"
SEED_DEEPSEEK_KEY="your_deepseek_key"

