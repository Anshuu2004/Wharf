generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// ─── Users ───────────────────────────────────────────────────────────────────
model User {
  id          String   @id @default(cuid())
  githubId    String   @unique
  username    String
  avatar      String
  email       String?
  githubAccessToken String?     // Encrypted OAuth token
  githubCreatedAt   DateTime? 
  installationId    String?      // GitHub App installation ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  repos       Repository[]
  apiKeys     UserApiKey[]
  profileReadmes ProfileReadme[]
  chatSessions ChatSession[]
  healthScores  HealthScore[]
}


// ─── Repositories ─────────────────────────────────────────────────────────────
model Repository {
  id          String   @id @default(cuid())
  owner       String
  name        String
  description String?
  stars       Int      @default(0)
  language    String?
  url         String
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  generations Generation[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([owner, name, userId])
}


// ─── Generations ──────────────────────────────────────────────────────────────
model Generation {
  id            String   @id @default(cuid())
  type          String   // README, TREEMAP, CHANGELOG, etc.
  content       String   @db.Text
  wordCount     Int?     // Storing the word count of the generated content
  options       Json?    // Store generation parameters
  
  repoId        String
  repository    Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
}


// ─── BYOK — User's Own API Keys ───────────────────────────────────────────────
model UserApiKey {
  id          String   @id @default(cuid())
  provider    String   // OPENAI, ANTHROPIC, GEMINI, GROQ, DEEPSEEK, etc.
  key         String   // Encrypted key
  label       String   @default("Primary") // To distinguish multiple keys
  isExhausted   Boolean  @default(false)
  usageCount    Int      @default(0)
  lastUsed      DateTime @default(now())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider, label])
}

// ─── System Key Pool — Shared Keys For Rotation ──────────────────────────────
model SystemKey {
  id            String   @id @default(cuid())
  provider      String   // GEMINI, ANTHROPIC, etc.
  key           String   // Encrypted key
  usageCount    Int      @default(0)
  isExhausted   Boolean  @default(false)
  lastUsed      DateTime @default(now())
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Profile Generation ────────────────────────────────────────────────────────
model ProfileReadme {
  id            String   @id @default(cuid())
  userId        String?
  username      String   // GitHub username
  content       String   @db.Text  // Generated README content
  template      String   // minimal, developer, creative, professional, terminal
  theme         String   // default, dark, ocean, sunset, forest, monochrome
  badges        String[] // Selected badges
  showStats     Boolean  @default(true)
  showTopLanguages Boolean @default(true)
  showContributions Boolean @default(true)
  generatedAt   DateTime @default(now())
  
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([username])
  @@index([generatedAt])
}

model ProfileStats {
  id              String   @id @default(cuid())
  totalProfiles   Int      @default(0)
  totalReadmes    Int      @default(0)
  totalStars      Int      @default(0)
  templatesUsed   Int      @default(0)
  topTemplate     String   @default("--")
  lastGenerated   DateTime?
  updatedAt       DateTime @updatedAt
}

// ─── Chat ────────────────────────────────────────────────────────────────────
model ChatSession {
  id            String    @id @default(cuid())
  userId        String
  title         String
  repoUrl       String?
  repoData      Json?     // Cached repo metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isArchived    Boolean   @default(false)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]
  analytics     ChatAnalytics[]

  @@index([userId])
  @@index([createdAt])
}

model ChatMessage {
  id            String    @id @default(cuid())
  sessionId     String
  role          String    // 'user' | 'assistant'
  content       String    @db.Text
  codeBlocks    Json?     // [{ language, code }]
  tokens        Int?      
  createdAt     DateTime  @default(now())

  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

model ChatAnalytics {
  id              String    @id @default(cuid())
  sessionId       String
  totalTokens     Int
  totalMessages   Int
  avgResponseTime Float
  createdAt       DateTime  @default(now())

  session         ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ─── Repo Health ──────────────────────────────────────────────────────────────
model HealthScore {
  id              String   @id @default(cuid())
  repoId          String?
  repoUrl         String   @unique
  repoName        String
  score           Int      // 0-100
  breakdown       Json     // { description: 18, installation: 20, usage: 10, techStack: 15, contributing: 10, license: 8, visuals: 2 }
  suggestions     String[] // ["Add screenshots (+3 points)", "Create CONTRIBUTING.md (+5 points)"]
  checkedAt       DateTime @default(now())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  contributionScore     Int?
  contributionBreakdown Json? // { hasContributing: true, hasIssueTemplates: false, hasPRTemplates: false, hasCodeOfConduct: false, hasGoodFirstIssues: false, hasCommunityLink: false }
  contributionSuggestions String[]

  @@index([userId])
  @@index([checkedAt])
  @@index([repoUrl])
}
